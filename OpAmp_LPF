<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Analog Circuit Calculator</title>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        body {
            font-family: Arial, sans-serif;
            max-width: 900px;
            margin: 0 auto;
            padding: 20px;
            background-color: #f5f5f5;
        }
        .calculator {
            background-color: white;
            border-radius: 10px;
            padding: 20px;
            box-shadow: 0 0 10px rgba(0,0,0,0.1);
        }
        h1 {
            color: #333;
            text-align: center;
            margin-bottom: 20px;
        }
        .tab-container {
            display: flex;
            margin-bottom: 20px;
            border-bottom: 1px solid #ddd;
        }
        .tab {
            padding: 10px 20px;
            cursor: pointer;
            background-color: #f1f1f1;
            border: none;
            border-radius: 5px 5px 0 0;
            margin-right: 5px;
        }
        .tab.active {
            background-color: #4CAF50;
            color: white;
        }
        .tab-content {
            display: none;
        }
        .tab-content.active {
            display: block;
        }
        .input-group {
            margin-bottom: 15px;
            display: flex;
            align-items: center;
        }
        label {
            width: 150px;
            font-weight: bold;
        }
        input, select {
            padding: 8px;
            border: 1px solid #ddd;
            border-radius: 4px;
            margin-right: 10px;
        }
        input {
            width: 100px;
        }
        button {
            background-color: #4CAF50;
            color: white;
            border: none;
            padding: 10px 15px;
            border-radius: 4px;
            cursor: pointer;
            font-size: 16px;
            margin-top: 10px;
            margin-right: 10px;
        }
        button:hover {
            background-color: #45a049;
        }
        .chart-container {
            margin-top: 30px;
            height: 400px;
        }
        .result {
            margin-top: 20px;
            padding: 15px;
            background-color: #e9f7ef;
            border-radius: 5px;
            display: none;
        }
        .unit-selector {
            width: 80px;
        }
        .button-group {
            display: flex;
        }
        .circuit-diagram {
            margin: 20px 0;
            text-align: center;
        }
        .circuit-diagram img {
            max-width: 100%;
            height: auto;
        }
        .opamp-config {
            margin-bottom: 20px;
            padding: 15px;
            border: 1px solid #ddd;
            border-radius: 5px;
        }
        .opamp-config h3 {
            margin-top: 0;
            color: #333;
        }
    </style>
</head>
<body>
    <div class="calculator">
        <h1>Analog Circuit Calculator</h1>
        
        <div class="tab-container">
            <button class="tab active" onclick="openTab('rc-filter')">RC Filter</button>
            <button class="tab" onclick="openTab('opamp-circuits')">Op-Amp Circuits</button>
        </div>
        
        <!-- RC Filter Tab -->
        <div id="rc-filter" class="tab-content active">
            <div class="input-group">
                <label for="resistance">Resistance (R):</label>
                <input type="number" id="resistance" value="1" min="0" step="any">
                <select id="resistance-unit" class="unit-selector">
                    <option value="1">Ω</option>
                    <option value="1000">kΩ</option>
                    <option value="1000000">MΩ</option>
                </select>
            </div>
            
            <div class="input-group">
                <label for="capacitance">Capacitance (C):</label>
                <input type="number" id="capacitance" value="1" min="0" step="any">
                <select id="capacitance-unit" class="unit-selector">
                    <option value="0.000000000001">pF</option>
                    <option value="0.000000001">nF</option>
                    <option value="0.000001" selected>μF</option>
                    <option value="1">F</option>
                </select>
            </div>
            
            <div class="input-group">
                <label for="cutoff-frequency">Cutoff Frequency (f<sub>c</sub>):</label>
                <input type="number" id="cutoff-frequency" value="1000" min="0" step="any">
                <select id="frequency-unit" class="unit-selector">
                    <option value="1">Hz</option>
                    <option value="1000" selected>kHz</option>
                    <option value="1000000">MHz</option>
                    <option value="1000000000">GHz</option>
                </select>
            </div>
            
            <div class="button-group">
                <button id="calculate-btn">Calculate</button>
                <button id="calculate-fc-btn">Calculate fc from R & C</button>
                <button id="reset-btn">Reset</button>
            </div>
            
            <div class="result" id="result">
                <h3>Results:</h3>
                <p id="calculated-values"></p>
            </div>
            
            <div class="chart-container">
                <canvas id="bodePlot"></canvas>
            </div>
        </div>
        
        <!-- Op-Amp Circuits Tab -->
        <div id="opamp-circuits" class="tab-content">
            <div class="opamp-config">
                <h3>Inverting Amplifier</h3>
                <div class="circuit-diagram">
                    <svg width="300" height="200" viewBox="0 0 300 200">
                        <!-- Op-Amp Triangle -->
                        <polygon points="100,50 150,100 100,150" fill="none" stroke="black" stroke-width="2"/>
                        <line x1="150" y1="100" x2="200" y2="100" stroke="black" stroke-width="2"/>
                        <!-- + and - inputs -->
                        <text x="80" y="45" font-size="20">-</text>
                        <text x="80" y="155" font-size="20">+</text>
                        <!-- Ground symbol at + input -->
                        <line x1="80" y1="160" x2="80" y2="180" stroke="black" stroke-width="2"/>
                        <line x1="70" y1="180" x2="90" y2="180" stroke="black" stroke-width="2"/>
                        <line x1="75" y1="185" x2="85" y2="185" stroke="black" stroke-width="2"/>
                        <line x1="78" y1="190" x2="82" y2="190" stroke="black" stroke-width="2"/>
                        <!-- Input resistor -->
                        <line x1="20" y1="100" x2="80" y2="100" stroke="black" stroke-width="2"/>
                        <rect x="40" y="90" width="40" height="20" fill="none" stroke="black" stroke-width="2"/>
                        <text x="60" y="105" text-anchor="middle">R1</text>
                        <!-- Feedback resistor -->
                        <line x1="150" y1="100" x2="150" y2="50" stroke="black" stroke-width="2"/>
                        <line x1="150" y1="50" x2="80" y2="50" stroke="black" stroke-width="2"/>
                        <rect x="100" y="40" width="40" height="20" fill="none" stroke="black" stroke-width="2"/>
                        <text x="120" y="55" text-anchor="middle">Rf</text>
                        <line x1="80" y1="50" x2="80" y2="90" stroke="black" stroke-width="2"/>
                        <!-- Input voltage -->
                        <line x1="0" y1="100" x2="20" y2="100" stroke="black" stroke-width="2"/>
                        <text x="10" y="95" text-anchor="middle">Vin</text>
                        <!-- Output voltage -->
                        <line x1="200" y1="100" x2="220" y2="100" stroke="black" stroke-width="2"/>
                        <text x="230" y="105" text-anchor="middle">Vout</text>
                    </svg>
                </div>
                
                <div class="input-group">
                    <label for="inverting-vin">Input Voltage (Vin):</label>
                    <input type="number" id="inverting-vin" value="1" step="any">
                    <select id="inverting-vin-unit" class="unit-selector">
                        <option value="1">V</option>
                        <option value="0.001">mV</option>
                    </select>
                </div>
                
                <div class="input-group">
                    <label for="inverting-r1">Input Resistor (R1):</label>
                    <input type="number" id="inverting-r1" value="1000" min="0" step="any">
                    <select id="inverting-r1-unit" class="unit-selector">
                        <option value="1">Ω</option>
                        <option value="1000">kΩ</option>
                        <option value="1000000">MΩ</option>
                    </select>
                </div>
                
                <div class="input-group">
                    <label for="inverting-rf">Feedback Resistor (Rf):</label>
                    <input type="number" id="inverting-rf" value="10000" min="0" step="any">
                    <select id="inverting-rf-unit" class="unit-selector">
                        <option value="1">Ω</option>
                        <option value="1000">kΩ</option>
                        <option value="1000000">MΩ</option>
                    </select>
                </div>
                
                <button id="calculate-inverting">Calculate Output</button>
                
                <div class="result" id="inverting-result">
                    <h3>Results:</h3>
                    <p id="inverting-output"></p>
                    <p id="inverting-gain"></p>
                </div>
            </div>
            
            <div class="opamp-config">
                <h3>Non-Inverting Amplifier</h3>
                <div class="circuit-diagram">
                    <svg width="300" height="200" viewBox="0 0 300 200">
                        <!-- Op-Amp Triangle -->
                        <polygon points="100,50 150,100 100,150" fill="none" stroke="black" stroke-width="2"/>
                        <line x1="150" y1="100" x2="200" y2="100" stroke="black" stroke-width="2"/>
                        <!-- + and - inputs -->
                        <text x="80" y="45" font-size="20">-</text>
                        <text x="80" y="155" font-size="20">+</text>
                        <!-- Input voltage at + input -->
                        <line x1="20" y1="150" x2="80" y2="150" stroke="black" stroke-width="2"/>
                        <line x1="0" y1="150" x2="20" y2="150" stroke="black" stroke-width="2"/>
                        <text x="10" y="145" text-anchor="middle">Vin</text>
                        <!-- Feedback resistor -->
                        <line x1="150" y1="100" x2="150" y2="50" stroke="black" stroke-width="2"/>
                        <line x1="150" y1="50" x2="80" y2="50" stroke="black" stroke-width="2"/>
                        <rect x="100" y="40" width="40" height="20" fill="none" stroke="black" stroke-width="2"/>
                        <text x="120" y="55" text-anchor="middle">Rf</text>
                        <!-- Ground resistor -->
                        <line x1="80" y1="50" x2="80" y2="90" stroke="black" stroke-width="2"/>
                        <rect x="60" y="80" width="40" height="20" fill="none" stroke="black" stroke-width="2"/>
                        <text x="80" y="95" text-anchor="middle">R1</text>
                        <line x1="80" y1="100" x2="80" y2="130" stroke="black" stroke-width="2"/>
                        <line x1="70" y1="130" x2="90" y2="130" stroke="black" stroke-width="2"/>
                        <line x1="75" y1="135" x2="85" y2="135" stroke="black" stroke-width="2"/>
                        <line x1="78" y1="140" x2="82" y2="140" stroke="black" stroke-width="2"/>
                        <!-- Output voltage -->
                        <line x1="200" y1="100" x2="220" y2="100" stroke="black" stroke-width="2"/>
                        <text x="230" y="105" text-anchor="middle">Vout</text>
                    </svg>
                </div>
                
                <div class="input-group">
                    <label for="noninverting-vin">Input Voltage (Vin):</label>
                    <input type="number" id="noninverting-vin" value="1" step="any">
                    <select id="noninverting-vin-unit" class="unit-selector">
                        <option value="1">V</option>
                        <option value="0.001">mV</option>
                    </select>
                </div>
                
                <div class="input-group">
                    <label for="noninverting-r1">Resistor to Ground (R1):</label>
                    <input type="number" id="noninverting-r1" value="1000" min="0" step="any">
                    <select id="noninverting-r1-unit" class="unit-selector">
                        <option value="1">Ω</option>
                        <option value="1000">kΩ</option>
                        <option value="1000000">MΩ</option>
                    </select>
                </div>
                
                <div class="input-group">
                    <label for="noninverting-rf">Feedback Resistor (Rf):</label>
                    <input type="number" id="noninverting-rf" value="10000" min="0" step="any">
                    <select id="noninverting-rf-unit" class="unit-selector">
                        <option value="1">Ω</option>
                        <option value="1000">kΩ</option>
                        <option value="1000000">MΩ</option>
                    </select>
                </div>
                
                <button id="calculate-noninverting">Calculate Output</button>
                
                <div class="result" id="noninverting-result">
                    <h3>Results:</h3>
                    <p id="noninverting-output"></p>
                    <p id="noninverting-gain"></p>
                </div>
            </div>
            
            <div class="opamp-config">
                <h3>Voltage Follower (Buffer)</h3>
                <div class="circuit-diagram">
                    <svg width="300" height="150" viewBox="0 0 300 150">
                        <!-- Op-Amp Triangle -->
                        <polygon points="100,50 150,100 100,150" fill="none" stroke="black" stroke-width="2"/>
                        <line x1="150" y1="100" x2="200" y2="100" stroke="black" stroke-width="2"/>
                        <!-- + and - inputs -->
                        <text x="80" y="45" font-size="20">-</text>
                        <text x="80" y="155" font-size="20">+</text>
                        <!-- Input voltage -->
                        <line x1="20" y1="150" x2="80" y2="150" stroke="black" stroke-width="2"/>
                        <line x1="0" y1="150" x2="20" y2="150" stroke="black" stroke-width="2"/>
                        <text x="10" y="145" text-anchor="middle">Vin</text>
                        <!-- Feedback connection -->
                        <line x1="150" y1="100" x2="150" y2="50" stroke="black" stroke-width="2"/>
                        <line x1="150" y1="50" x2="80" y2="50" stroke="black" stroke-width="2"/>
                        <line x1="80" y1="50" x2="80" y2="130" stroke="black" stroke-width="2"/>
                        <!-- Output voltage -->
                        <line x1="200" y1="100" x2="220" y2="100" stroke="black" stroke-width="2"/>
                        <text x="230" y="105" text-anchor="middle">Vout</text>
                    </svg>
                </div>
                
                <div class="input-group">
                    <label for="follower-vin">Input Voltage (Vin):</label>
                    <input type="number" id="follower-vin" value="1" step="any">
                    <select id="follower-vin-unit" class="unit-selector">
                        <option value="1">V</option>
                        <option value="0.001">mV</option>
                    </select>
                </div>
                
                <button id="calculate-follower">Calculate Output</button>
                
                <div class="result" id="follower-result">
                    <h3>Results:</h3>
                    <p id="follower-output"></p>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Initialize Chart for RC Filter
        const ctx = document.getElementById('bodePlot').getContext('2d');
        let bodeChart = new Chart(ctx, {
            type: 'line',
            data: {
                datasets: [{
                    label: 'Magnitude (dB)',
                    borderColor: 'rgb(75, 192, 192)',
                    backgroundColor: 'rgba(75, 192, 192, 0.2)',
                    borderWidth: 2,
                    yAxisID: 'y',
                    tension: 0.1
                }, {
                    label: 'Phase (degrees)',
                    borderColor: 'rgb(255, 99, 132)',
                    backgroundColor: 'rgba(255, 99, 132, 0.2)',
                    borderWidth: 2,
                    yAxisID: 'y1',
                    tension: 0.1
                }]
            },
            options: {
                responsive: true,
                interaction: {
                    mode: 'index',
                    intersect: false,
                },
                scales: {
                    x: {
                        type: 'logarithmic',
                        title: {
                            display: true,
                            text: 'Frequency (Hz)'
                        }
                    },
                    y: {
                        type: 'linear',
                        display: true,
                        position: 'left',
                        title: {
                            display: true,
                            text: 'Magnitude (dB)'
                        }
                    },
                    y1: {
                        type: 'linear',
                        display: true,
                        position: 'right',
                        title: {
                            display: true,
                            text: 'Phase (degrees)'
                        },
                        min: -90,
                        max: 0,
                        grid: {
                            drawOnChartArea: false
                        }
                    }
                },
                plugins: {
                    annotation: {
                        annotations: {
                            line1: {
                                type: 'line',
                                yMin: -3,
                                yMax: -3,
                                borderColor: 'rgb(255, 159, 64)',
                                borderWidth: 2,
                                borderDash: [6, 6],
                                label: {
                                    content: '-3dB',
                                    enabled: true,
                                    position: 'left'
                                }
                            },
                            line2: {
                                type: 'line',
                                xMin: 0,
                                xMax: 0,
                                yMin: 0,
                                yMax: 0,
                                borderColor: 'rgb(54, 162, 235)',
                                borderWidth: 2,
                                borderDash: [6, 6],
                                label: {
                                    content: 'fc',
                                    enabled: true,
                                    position: 'top'
                                }
                            }
                        }
                    }
                }
            }
        });

        // Function to calculate cutoff frequency from R and C
        function calculateCutoffFrequency(R, C) {
            return 1 / (2 * Math.PI * R * C);
        }

        // Function to calculate component values from cutoff frequency
        function calculateComponentsFromCutoff(fc, knownValue, isResistor) {
            if (isResistor) {
                // Calculate C from R and fc
                return 1 / (2 * Math.PI * knownValue * fc);
            } else {
                // Calculate R from C and fc
                return 1 / (2 * Math.PI * knownValue * fc);
            }
        }

        // Function to generate Bode plot data
        function generateBodeData(fc) {
            const frequencies = [];
            const magnitudes = [];
            const phases = [];
            
            // Generate frequency range from 0.01fc to 100fc on a log scale
            const startFreq = fc / 100;
            const endFreq = fc * 100;
            const steps = 100;
            
            for (let i = 0; i <= steps; i++) {
                const logFreq = Math.log10(startFreq) + (Math.log10(endFreq) - Math.log10(startFreq)) * i / steps;
                const freq = Math.pow(10, logFreq);
                frequencies.push(freq);
                
                // Calculate magnitude and phase
                const ratio = freq / fc;
                const magnitude = -10 * Math.log10(1 + Math.pow(ratio, 2));
                const phase = -Math.atan(ratio) * 180 / Math.PI;
                
                magnitudes.push(magnitude);
                phases.push(phase);
            }
            
            return { frequencies, magnitudes, phases };
        }

        // Function to update the Bode plot
        function updateBodePlot(fc) {
            const { frequencies, magnitudes, phases } = generateBodeData(fc);
            
            bodeChart.data.labels = frequencies;
            bodeChart.data.datasets[0].data = magnitudes.map((mag, i) => ({
                x: frequencies[i],
                y: mag
            }));
            bodeChart.data.datasets[1].data = phases.map((phase, i) => ({
                x: frequencies[i],
                y: phase
            }));
            
            // Update the -3dB and fc markers
            bodeChart.options.plugins.annotation.annotations.line1.yMin = -3;
            bodeChart.options.plugins.annotation.annotations.line1.yMax = -3;
            
            bodeChart.options.plugins.annotation.annotations.line2.xMin = fc;
            bodeChart.options.plugins.annotation.annotations.line2.xMax = fc;
            bodeChart.options.plugins.annotation.annotations.line2.yMin = -90;
            bodeChart.options.plugins.annotation.annotations.line2.yMax = 0;
            bodeChart.options.plugins.annotation.annotations.line2.label.content = 'fc = ' + formatEngineering(fc) + 'Hz';
            
            bodeChart.update();
        }

        // Function to format number with engineering notation
        function formatEngineering(num) {
            if (num === 0) return "0";
            
            const prefixes = ['p', 'n', 'μ', 'm', '', 'k', 'M', 'G', 'T'];
            const exponent = Math.floor(Math.log10(Math.abs(num)));
            const base = Math.floor(exponent / 3);
            const scaled = num / Math.pow(10, base * 3);
            
            // Find the appropriate prefix
            let prefixIndex = base + 4;
            if (prefixIndex < 0) prefixIndex = 0;
            if (prefixIndex >= prefixes.length) prefixIndex = prefixes.length - 1;
            
            return scaled.toFixed(3) + ' ' + prefixes[prefixIndex];
        }

        // Function to auto-calculate when inputs change (RC Filter)
        function autoCalculate() {
            const resistance = parseFloat(document.getElementById('resistance').value);
            const resistanceUnit = parseFloat(document.getElementById('resistance-unit').value);
            const R = resistance * resistanceUnit;
            
            const capacitance = parseFloat(document.getElementById('capacitance').value);
            const capacitanceUnit = parseFloat(document.getElementById('capacitance-unit').value);
            const C = capacitance * capacitanceUnit;
            
            const cutoffFrequency = parseFloat(document.getElementById('cutoff-frequency').value);
            const frequencyUnit = parseFloat(document.getElementById('frequency-unit').value);
            const fc = cutoffFrequency * frequencyUnit;
            
            let resultText = '';
            
            // Count how many values are provided
            const providedValues = [R, C, fc].filter(val => val > 0).length;
            
            if (providedValues >= 2) {
                if (R > 0 && C > 0 && fc > 0) {
                    // All three values provided - verify consistency
                    const calculatedFc = calculateCutoffFrequency(R, C);
                    const percentDiff = Math.abs((calculatedFc - fc) / fc * 100);
                    
                    resultText = `Calculated fc: ${formatEngineering(calculatedFc)}Hz (${percentDiff.toFixed(2)}% difference from provided fc)`;
                    updateBodePlot(calculatedFc);
                } else if (R > 0 && fc > 0) {
                    // Calculate C
                    const calculatedC = calculateComponentsFromCutoff(fc, R, true);
                    document.getElementById('capacitance').value = calculatedC / capacitanceUnit;
                    resultText = `Calculated Capacitance: ${formatEngineering(calculatedC)}F`;
                    updateBodePlot(fc);
                } else if (C > 0 && fc > 0) {
                    // Calculate R
                    const calculatedR = calculateComponentsFromCutoff(fc, C, false);
                    document.getElementById('resistance').value = calculatedR / resistanceUnit;
                    resultText = `Calculated Resistance: ${formatEngineering(calculatedR)}Ω`;
                    updateBodePlot(fc);
                } else if (R > 0 && C > 0) {
                    // Calculate fc
                    const calculatedFc = calculateCutoffFrequency(R, C);
                    document.getElementById('cutoff-frequency').value = calculatedFc / frequencyUnit;
                    resultText = `Calculated Cutoff Frequency: ${formatEngineering(calculatedFc)}Hz`;
                    updateBodePlot(calculatedFc);
                }
                
                document.getElementById('calculated-values').innerHTML = resultText;
                document.getElementById('result').style.display = 'block';
            }
        }

        // Function to calculate inverting amplifier output
        function calculateInvertingAmplifier() {
            const vin = parseFloat(document.getElementById('inverting-vin').value) * 
                        parseFloat(document.getElementById('inverting-vin-unit').value);
            const r1 = parseFloat(document.getElementById('inverting-r1').value) * 
                       parseFloat(document.getElementById('inverting-r1-unit').value);
            const rf = parseFloat(document.getElementById('inverting-rf').value) * 
                       parseFloat(document.getElementById('inverting-rf-unit').value);
            
            if (r1 <= 0 || rf <= 0) {
                alert("Resistor values must be positive");
                return;
            }
            
            const gain = -rf / r1;
            const vout = gain * vin;
            
            document.getElementById('inverting-output').textContent = 
                `Output Voltage (Vout): ${vout.toFixed(6)} V (${formatEngineering(vout)}V)`;
            document.getElementById('inverting-gain').textContent = 
                `Voltage Gain: ${gain.toFixed(4)}`;
            document.getElementById('inverting-result').style.display = 'block';
        }

        // Function to calculate non-inverting amplifier output
        function calculateNonInvertingAmplifier() {
            const vin = parseFloat(document.getElementById('noninverting-vin').value) * 
                        parseFloat(document.getElementById('noninverting-vin-unit').value);
            const r1 = parseFloat(document.getElementById('noninverting-r1').value) * 
                       parseFloat(document.getElementById('noninverting-r1-unit').value);
            const rf = parseFloat(document.getElementById('noninverting-rf').value) * 
                       parseFloat(document.getElementById('noninverting-rf-unit').value);
            
            if (r1 <= 0 || rf <= 0) {
                alert("Resistor values must be positive");
                return;
            }
            
            const gain = 1 + (rf / r1);
            const vout = gain * vin;
            
            document.getElementById('noninverting-output').textContent = 
                `Output Voltage (Vout): ${vout.toFixed(6)} V (${formatEngineering(vout)}V)`;
            document.getElementById('noninverting-gain').textContent = 
                `Voltage Gain: ${gain.toFixed(4)}`;
            document.getElementById('noninverting-result').style.display = 'block';
        }

        // Function to calculate voltage follower output
        function calculateVoltageFollower() {
            const vin = parseFloat(document.getElementById('follower-vin').value) * 
                        parseFloat(document.getElementById('follower-vin-unit').value);
            
            const vout = vin;
            
            document.getElementById('follower-output').textContent = 
                `Output Voltage (Vout): ${vout.toFixed(6)} V (${formatEngineering(vout)}V)`;
            document.getElementById('follower-result').style.display = 'block';
        }

        // Function to switch between tabs
        function openTab(tabName) {
            const tabs = document.getElementsByClassName('tab-content');
            for (let i = 0; i < tabs.length; i++) {
                tabs[i].classList.remove('active');
            }
            
            const tabButtons = document.getElementsByClassName('tab');
            for (let i = 0; i < tabButtons.length; i++) {
                tabButtons[i].classList.remove('active');
            }
            
            document.getElementById(tabName).classList.add('active');
            event.currentTarget.classList.add('active');
        }

        // Event listeners for RC Filter
        document.getElementById('resistance').addEventListener('input', autoCalculate);
        document.getElementById('capacitance').addEventListener('input', autoCalculate);
        document.getElementById('cutoff-frequency').addEventListener('input', autoCalculate);
        document.getElementById('resistance-unit').addEventListener('change', autoCalculate);
        document.getElementById('capacitance-unit').addEventListener('change', autoCalculate);
        document.getElementById('frequency-unit').addEventListener('change', autoCalculate);
        document.getElementById('calculate-btn').addEventListener('click', autoCalculate);

        document.getElementById('calculate-fc-btn').addEventListener('click', function() {
            const resistance = parseFloat(document.getElementById('resistance').value);
            const resistanceUnit = parseFloat(document.getElementById('resistance-unit').value);
            const R = resistance * resistanceUnit;
            
            const capacitance = parseFloat(document.getElementById('capacitance').value);
            const capacitanceUnit = parseFloat(document.getElementById('capacitance-unit').value);
            const C = capacitance * capacitanceUnit;
            
            if (R > 0 && C > 0) {
                const fc = calculateCutoffFrequency(R, C);
                const frequencyUnit = parseFloat(document.getElementById('frequency-unit').value);
                document.getElementById('cutoff-frequency').value = fc / frequencyUnit;
                
                document.getElementById('calculated-values').innerHTML = 
                    `Cutoff frequency: ${formatEngineering(fc)}Hz`;
                document.getElementById('result').style.display = 'block';
                
                updateBodePlot(fc);
            } else {
                alert('Please provide both resistance and capacitance values.');
            }
        });

        document.getElementById('reset-btn').addEventListener('click', function() {
            document.getElementById('resistance').value = '1';
            document.getElementById('capacitance').value = '1';
            document.getElementById('cutoff-frequency').value = '1000';
            document.getElementById('result').style.display = 'none';
            updateBodePlot(1000);
        });

        // Event listeners for Op-Amp circuits
        document.getElementById('calculate-inverting').addEventListener('click', calculateInvertingAmplifier);
        document.getElementById('calculate-noninverting').addEventListener('click', calculateNonInvertingAmplifier);
        document.getElementById('calculate-follower').addEventListener('click', calculateVoltageFollower);

        // Initialize with default values
        updateBodePlot(1000); // Default to 1kHz
    </script>
</body>
</html>
